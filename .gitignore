# Clips Virais — ignore local state and generated media, not source assets.
# Credenciais, configuracoes privadas e backups
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.env
*.env.local
*.env.*.local
.envrc
*.pem
*.key
*.p12
*.pfx
credentials.json
token.json
secrets/
credentials/

# Backups, arquivos parciais e temporarios de instalacao
*.bak
*.bak-*
*.backup
*.old
*.orig
*.rej
*.tmp
*.temp
*.part
*.download
*~
*.swp
*.swo
*.log

