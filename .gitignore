# Modelos Piper sao baixados por scripts/install_voices.py.
# Manter no Git os .onnx.json e MODEL_CARD (configuracao/licenca).
/models/*.onnx
/models/**/*.onnx
/models/*.pt
/models/*.pth
/models/*.ckpt
/models/*.safetensors

# Midias de teste e pacotes gerados na raiz; nao ignorar docs/evidence
/*.mp4
/*.mov
/*.mkv
/*.webm
/*.wav
/*.mp3
/*.m4a
/*.zip
/*.7z
/*.tar
/*.tar.gz

# Configuracao e cache local de agentes/editores (preservar skills versionadas)
.claude/settings.local.json
.agents/.cache/
.opencode/cache/
.codex/tmp/
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Assets de entrada e trabalho por producao ficam no host/volume.
# Preservar apenas os marcadores das pastas de assets.
/assets/*
!/assets/.gitkeep
!/assets/gameplay/
!/assets/shorts/
!/assets/images/
!/assets/persona/
/assets/gameplay/*
/assets/shorts/*
/assets/images/*
/assets/persona/*
!/assets/gameplay/.gitkeep
!/assets/shorts/.gitkeep
!/assets/images/.gitkeep
!/assets/persona/.gitkeep
/assets/clips/
/assets/uploads/

# Workspace temporario — preservar a estrutura da pasta
/temp/*
!/temp/.gitkeep
