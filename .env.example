# Não copie sobre uma instalação existente. Execute start.ps1 ou sh start.sh.
# O container setup gera .env com todos os segredos locais automaticamente.
STUDIO_TIMEZONE=America/Sao_Paulo
POSTIZ_PUBLIC_URL=http://localhost:4007
POSTIZ_ADMIN_EMAIL=admin@studio.local
PIPER_MODEL=/models/pt_BR-faber-medium.onnx
# IDs exatos de modelos que você confirmou gratuitos; separados por vírgula.
# Se vazio, crie studio-free no OmniRoute depois de conectar seus provedores.
OMNIROUTE_FREE_MODELS=
# Credenciais externas, emitidas pelos respectivos consoles OAuth.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
