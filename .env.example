# Estúdio pessoal de produção manual. Nunca substitua um .env existente.
# Executar start.ps1 / start.sh gera as chaves locais que faltam.
STUDIO_TIMEZONE=America/Sao_Paulo
PIPER_MODEL=/models/pt_BR-faber-medium.onnx
# Os modelos e credenciais do OmniRoute existente serão preservados.
# Deixe vazio se seu combo studio-free já existe.
OMNIROUTE_FREE_MODELS=
