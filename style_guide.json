    "video_files_downloaded": 0,
    "reference_videos_measured": 0,
    "visual_content_of_provided_urls_verified": false,
    "rule_frequency_3plus_verified": false,
    "numeric_parameter_status": "defaults_criativos_propostos_nao_medidos",
